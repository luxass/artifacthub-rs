---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import "../styles/global.css";

export async function getStaticPaths() {
  return (await getCollection("docs")).map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { id: entry.id },
  }));
}

interface Props {
  id: CollectionEntry<"docs">["id"];
}

const entries = (await getCollection("docs")).sort(
  (left, right) => left.data.order - right.data.order,
);
const entry = entries.find((entry) => entry.id === Astro.props.id);
if (!entry) {
  throw new Error(`Documentation entry not found: ${Astro.props.id}`);
}
const navigation = entries.map((entry) => ({
  href: entry.id === "index" ? "/" : `/${entry.id}/`,
  label: entry.data.navTitle,
}));
const { Content } = await render(entry);
const currentPath = Astro.url.pathname;
const currentIndex = navigation.findIndex((item) => item.href === currentPath);
const previous = navigation[currentIndex - 1];
const next = navigation[currentIndex + 1];
const source = "https://github.com/luxass/artifacthub-rs";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={entry.data.description} />
    <meta name="theme-color" content="#f3f7f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101b1a" media="(prefers-color-scheme: dark)" />
    <title>{entry.data.title} | artifacthub-mcp</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-background font-sans text-[15px] leading-[1.7] text-foreground">
    <a
      class="fixed -top-24 left-4 z-10 bg-background px-3 py-2 text-accent focus:top-4"
      href="#content"
    >Skip to content</a>
    <div class="mx-auto max-w-[720px] px-5 py-6 sm:px-6">
      <header class="mb-8 flex flex-col justify-between gap-4 border-b border-line pb-4 leading-normal sm:flex-row sm:items-center">
        <a
          class="self-start font-mono text-sm font-medium hover:text-accent"
          href="/"
          aria-label="Artifact Hub MCP home"
          aria-current={currentPath === "/" ? "page" : undefined}
        >artifacthub-mcp</a>
        <div class="flex items-center justify-between gap-5 text-sm sm:justify-start sm:gap-8">
          <nav class="flex items-center gap-5" aria-label="Documentation">
            {navigation.map((item) => (
              <a
                href={item.href}
                aria-current={item.href === currentPath ? "page" : undefined}
                class:list={[
                  "whitespace-nowrap hover:text-accent",
                  item.href === currentPath
                    ? "font-medium text-foreground underline decoration-accent underline-offset-4"
                    : "text-muted",
                ]}
              >{item.label}</a>
            ))}
          </nav>
          <a
            class="-my-2 inline-flex size-9 items-center justify-center text-muted hover:text-accent"
            href={source}
            aria-label="View source on GitHub"
            title="GitHub"
          >
            <svg class="size-5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        </div>
      </header>
      <main id="content" tabindex="-1" class="min-w-0">
        <div class="mb-8">
          <h1 class="text-[28px] leading-tight font-semibold tracking-tight">{entry.data.title}</h1>
          <p class="mt-2 text-muted">{entry.data.description}</p>
        </div>
        <article class="prose"><Content /></article>
        <nav class="mt-10 flex justify-between gap-4 border-t border-line pt-4 text-sm text-accent" aria-label="Previous and next pages">
          {previous ? (
            <a class="hover:underline" href={previous.href}>← {previous.label}</a>
          ) : <span />}
          {next && (
            <a class="text-right hover:underline" href={next.href}>{next.label} →</a>
          )}
        </nav>
      </main>
      <footer class="mt-8 flex flex-wrap justify-between gap-3 text-xs text-muted">
        <a class="hover:text-accent" href={source + "/tree/main/docs"}>source</a>
        <a class="hover:text-accent" href="https://artifacthub.io">artifacthub.io</a>
      </footer>
    </div>
  </body>
</html>
