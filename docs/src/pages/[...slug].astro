---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import "../styles/global.css";

export async function getStaticPaths() {
  const entries = (await getCollection("docs")).sort(
    (left, right) => left.data.order - right.data.order,
  );
  const navigation = entries.map((entry) => ({
    href: entry.id === "index" ? "/" : `/${entry.id}/`,
    label: entry.data.navTitle,
  }));

  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry, navigation },
  }));
}

interface Props {
  entry: CollectionEntry<"docs">;
  navigation: { href: string; label: string }[];
}

const { entry, navigation } = Astro.props;
const { Content } = await render(entry);
const currentPath = Astro.url.pathname;
const currentIndex = navigation.findIndex((item) => item.href === currentPath);
const previous = navigation[currentIndex - 1];
const next = navigation[currentIndex + 1];
const source = "https://github.com/luxass/artifacthub-rs";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={entry.data.description} />
    <meta name="theme-color" content="#f3f7f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101b1a" media="(prefers-color-scheme: dark)" />
    <title>{entry.data.title} | artifacthub-mcp</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-background font-sans text-[13px] leading-relaxed text-foreground">
    <a
      class="fixed -top-24 left-4 z-10 bg-background px-3 py-2 text-accent focus:top-4"
      href="#content"
    >Skip to content</a>
    <div class="mx-auto max-w-[690px] px-6 py-5">
      <header class="mb-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 font-mono leading-normal">
        <a class="font-medium hover:text-accent" href="/" aria-label="Artifact Hub MCP home">artifacthub-mcp</a>
        <nav class="flex flex-wrap gap-x-3 gap-y-2 text-muted" aria-label="Documentation">
          {navigation.filter((item) => item.href !== "/").map((item) => (
            <a
              href={item.href}
              aria-current={item.href === currentPath ? "page" : undefined}
              class:list={[
                "lowercase hover:text-accent",
                item.href === currentPath && "text-foreground underline underline-offset-4",
              ]}
            >{item.label}</a>
          ))}
          <a class="hover:text-accent" href={source}>github</a>
        </nav>
      </header>
      <main id="content" tabindex="-1" class="min-w-0">
        <div class="mb-8">
          <h1 class="text-2xl leading-8 font-semibold tracking-tight">{entry.data.title}</h1>
          <p class="mt-2 text-muted">{entry.data.description}</p>
        </div>
        <article class="prose"><Content /></article>
        <nav class="mt-10 flex justify-between gap-4 border-t border-line pt-4 font-mono text-xs text-accent" aria-label="Previous and next pages">
          {previous ? (
            <a class="hover:underline" href={previous.href}>← {previous.label}</a>
          ) : <span />}
          {next && (
            <a class="text-right hover:underline" href={next.href}>{next.label} →</a>
          )}
        </nav>
      </main>
      <footer class="mt-8 flex flex-wrap justify-between gap-3 font-mono text-xs text-muted">
        <a class="hover:text-accent" href={source + "/tree/main/docs"}>source</a>
        <a class="hover:text-accent" href="https://artifacthub.io">artifacthub.io</a>
      </footer>
    </div>
  </body>
</html>
